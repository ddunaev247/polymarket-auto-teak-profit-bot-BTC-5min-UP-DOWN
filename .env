# Валидные настройки для рынка Polymarket (на сети Polygon Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
CHAIN_ID=137
HOST=https://clob.polymarket.com

# HTTP/SOCKS5 прокси для обхода гео-блокировки Polymarket
PROXY_URL=http://login:pass@ip:port

CLOB_USE_HTTP2=0

# Приватный ключ вашего кошелька (Без '0x' в начале)
PRIVATE_KEY=***

# Ваш публичный адрес кошелька (EOA / Relayer API Key Address)
FUNDER_ADDRESS=***

# Polymarket Proxy Wallet — адрес подписанта
PROXY_ADDRESS=***

# Размер ордера по умолчанию (количество акций)
ORDER_SIZE=10
# Отступ покупки от рынка (0.04 = 4 цента ниже текущей цены)
BUY_OFFSET=0.01
# Наценка продажи над ценой покупки (0.10 = 10 центов выше)
SELL_OFFSET=0.29
# Задержка проверки ордеров (в секундах)
CHECK_INTERVAL_SEC=1
# Порт веб-сервера
WEB_PORT=5000


# Запись в базу (true/false)
RECORD_EVENTS=false

# Interval for price polling (lower = faster updates, ~0.3s matches real-time)
PRICE_INTERVAL=0.3
